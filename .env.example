# Development
APP_ENV=development
SECRET_KEY=replace-with-a-long-random-secret
MONGO_URI=mongodb://localhost:27017/inclusive_match_db
SESSION_COOKIE_SECURE=false

# Cloudinary Persistent Profile Photo Storage
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Keep empty for same-origin Socket.IO. In production you may set:
# SOCKETIO_CORS_ALLOWED_ORIGINS=https://your-app.onrender.com

# WebRTC
WEBRTC_STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302

# REQUIRED FOR RELIABLE CROSS-NETWORK PRODUCTION CALLS:
# Get these from a TURN provider. Never commit real credentials to Git.
WEBRTC_TURN_URL=
WEBRTC_TURN_TLS_URL=
WEBRTC_TURN_USERNAME=
WEBRTC_TURN_CREDENTIAL=

# Production example:
# APP_ENV=production
# SESSION_COOKIE_SECURE=true
# SECRET_KEY=<long-random-secret>
# MONGO_URI=<mongodb-atlas-connection-string>
# SOCKETIO_CORS_ALLOWED_ORIGINS=https://your-app.onrender.com

# Brevo (formerly Sendinblue) Transactional SMTP & Password Reset
# Official docs: https://www.brevo.com/ (SMTP relay: smtp-relay.brevo.com, port 587)
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_LOGIN=
BREVO_SMTP_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=InclusiveMatch AI
APP_BASE_URL=https://incusivematch-ai.onrender.com

